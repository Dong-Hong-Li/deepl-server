{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug HTTP Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "MCP_TRANSPORT": "http",
                "MCP_HTTP_ADDR": ":8080"
            }
        },
        {
            "name": "Debug MCP (stdio)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "MCP_TRANSPORT": "stdio"
            }
        },
        {
            "name": "Attach to Process",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": 0
        }
    ]
}