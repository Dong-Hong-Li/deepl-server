# DeepL API Key — get one at https://www.deepl.com/pro-api
DEEPL_API_KEY=your-deepl-api-key-here

# MCP transport: stdio (default, for Cursor command) or http
MCP_TRANSPORT=http
MCP_HTTP_ADDR=:8080

    # Optional Bearer token for HTTP MCP endpoint
    # MCP_AUTH_TOKEN=your-shared-secret

# OSS Object Storage Config（aws-sdk-go-v2/service/s3，支持 AWS S3 及 S3 兼容 OSS）
# oss 端点（AWS 示例：https://s3.ap-northeast-1.amazonaws.com 或桶域名）
APP_OSS_ENDPOINT=https://your-bucket.s3.your-region.amazonaws.com
# oss 访问密钥（AWS Access Key ID）
APP_OSS_ACCESS_KEY=your-aws-access-key-id
# oss 密钥（AWS Secret Access Key）
APP_OSS_SECRET_KEY=your-aws-secret-access-key
# oss 桶
APP_OSS_BUCKET=your-bucket-name
# oss 区域（如 ap-northeast-1、us-east-1）
APP_OSS_REGION=your-aws-region
# oss 预签名 URL 有效期（秒）
APP_OSS_PRESIGN_GET_EXPIRES_SEC=3600
# 最大文件大小（字节），5242880 = 5MB，对齐 DeepL Free API 文档上限
APP_MAX_FILE_SIZE=5242880